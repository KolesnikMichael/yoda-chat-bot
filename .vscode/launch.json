{
    "configurations": [        
        {
            "name": "Attach debugger to process",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Debug with test account",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/yoda_chat_bot.py",
            "console": "integratedTerminal",
            "args": ["--test"]
        }
    ]
}