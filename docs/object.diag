' https://www.plantuml.com/plantuml/uml/SyfFKj2rKt3CoKnELR1Io4ZDoSa700005
@startuml

object Composer {
name
token
capabilities[]
settings[]
}

object PTB_update {
update_id
message
}

object Chat {
id
type
threads[]
}


object Thread {
id
messages[]
}

object Message {
message_id
from_user
date
chat_id
text
audio
document
photo
video
voice
video_note
caption
location
poll
quote
}


object AI_provider {
name
token
}

object AI_model {
name
ai_provider_name
capabilities[]
settings[]
}

object Capability {
name
description
ai_model
}

object User { 
id
first_name
last_name
username
language_code
timezone
location
known_since
traits[]
topics[]
interests[]
}

Composer::capabilities --> Capability
Capability::AI_model --> AI_model
AI_model::AI_provider_name --> AI_provider
Thread::users --> User
PTB_update::message --> Message
Chat::threads --> Thread
Message --> Thread::messages
Message::from_user --> User
Message::chat_id --> Chat

@enduml